# Cache files
.DS_Store
__pycache__/
.coverage
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints

# Virtual Environments
.venv*
venv/

# IDEs
.vscode/
.idea/

# Build files
dist/

# Data files (general)
*.gif
*.log
*.bak

# Ignore loose data files in repo root only
/*.txt
/*.pdf
/*.csv
/*.json
/*.jsonl

# Runtime-generated fixture data
murphy/fixture_data/
*.exe

# Secrets and sensitive files
secrets.env
.env
gcp-login.json

# Google API credentials
credentials.json
token.json

# Temp
temp
tmp
temp-profile-*
screenshot.png

# Output directories
output/
*/output/
# Allow a frozen eval plan under murphy/output/ while ignoring generated runs
!murphy/output/
# Ignore generated Murphy output; keep frozen eval plan versioned
murphy/output/*
!murphy/output/eval_test_1.yaml
# Explicit: prepare_logs / batch eval artifacts (also matched by murphy/output/*)
murphy/output/eval_run_rows.jsonl
murphy/output/eval_run_rows.csv
murphy/output/eval_run_summary.jsonl
murphy/output/evaluation_report.json
murphy/output/evaluation_report.md
murphy/browser_profile/
browser_profile/

# Batch runs (also matched by murphy/output/*)
murphy/output/run_*/

